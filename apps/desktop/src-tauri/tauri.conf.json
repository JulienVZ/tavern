{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavern",
  "identifier": "io.github.julienvz.tavern",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter tavern-ui dev",
    "beforeBuildCommand": "pnpm --filter tavern-ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tavern",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
