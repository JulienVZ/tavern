# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Configuration of a Tavern instance.
#
# Do not edit this file. Run ./scripts/init.sh: it copies it to .env and
# generates the secrets that are still empty. Then edit .env.
# Never commit .env: it contains secrets.
#
# Reference: docs/configuration.md

# ---------------------------------------------------------------------------
# Domains (required)
# ---------------------------------------------------------------------------

# Public host name of the instance: API and gateway. This is the address users
# type in the client. A DNS A/AAAA record must point to this machine.
# For a test on your own computer use: localhost
TAVERN_DOMAIN=

# Public host name of LiveKit signalling (voice and video). Must differ from
# TAVERN_DOMAIN and point to the same machine.
# For a test on your own computer use: livekit.localhost
LIVEKIT_DOMAIN=

# ---------------------------------------------------------------------------
# Reverse proxy (Caddy)
# ---------------------------------------------------------------------------

# Host ports. Certificates are obtained automatically from Let's Encrypt,
# which requires port 80 and 443 to be reachable from the internet.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_USER=tavern
POSTGRES_DB=tavern

# Secret, generated by init.sh. Hexadecimal only (it is embedded in a URL).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Image to run. Leave empty to build it from this repository.
TAVERN_SERVER_IMAGE=

# Apply database migrations at start-up (true/false).
TAVERN_RUN_MIGRATIONS=true

# Log filter: error, warn, info, debug, trace, or a tracing directive such as
# "tavern_server=debug,info". Logs never contain message content or secrets.
TAVERN_LOG_LEVEL=info

# Log format: text or json.
TAVERN_LOG_FORMAT=text

# URL where the source code of THIS instance can be obtained, shown by
# GET /version. If you run modified code, the AGPL requires you to offer the
# modified source to your users: put its URL here.
TAVERN_SOURCE_URL=

# ---------------------------------------------------------------------------
# LiveKit (voice, video, screen sharing)
# ---------------------------------------------------------------------------

# API key and secret shared by the Tavern server and LiveKit.
# Secrets, generated by init.sh.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public IPv4 address of this machine, advertised to clients for media.
# Required on a real deployment (VPS: its public IP; home server: the public
# IP of your router). Leave empty only for a local test.
LIVEKIT_NODE_IP=

# Media ports, published on the host. They must also be forwarded by your
# router or opened in your firewall. If you change them, change tcp_port and
# udp_port in livekit.yaml to the same values.
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
